# Grafana configuration
GRAFANA_PORT=8007

# Nvidia DCGM Exporter configuration (if profiles includes gpu)
DCGM_EXPORTER_PORT=9407

# Telegram Alerting Credentials
# Get your Bot Token by messaging @BotFather on Telegram (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Get your Chat ID by messaging @myidbot or @userinfobot (e.g. 987654321, or negative numbers for groups like -100123456789)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Primary PC Configuration (Targets & Aliases)
# Define the IP/Port where the Node Exporter container or binary is reachable
PC1_TARGET=host.docker.internal:9107
# Define a custom human-readable PC name for Telegram alerts
PC1_ALIAS=Main-Server
# Define the actual IP address to display in alerts
PC1_IP=127.0.0.1
